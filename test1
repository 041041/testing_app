%macro gen_tp_join_adsl(_dsnin =             
                       ,_dsnout =           
                       ,_trtoption = OPTION1 
                       ,_dropvars = 
                       ,_analstartdtvar=
                       ,_analstarttmvar=
                       ,_analstartdtmvar=
                       ,_analenddtvar=
                       ,_analendtmvar= 
                       ,_analenddtmvar=                     
                       );

***************************************************************************************;
* Specification 1                                                                     *;
*   - Initialize global and local macro variables                                     *;
*   - Get the number of periods into a macro variable                                 *;
*   - Check the existence of treatment time and analysis time variables               *; 
***************************************************************************************;

%global _anal_varexist _anal_missvars g_adsl_pre_lag;
%local _trt_time _anal_time _anal_end_time _i _j _k _l _m;

%if %bquote(&g_adsl_pre_lag) = %str() %then %do;
    %let g_adsl_pre_lag = 0;
%end;

%let _trt_time=N;
%let _anal_time=N;
%let _anal_end_time=N;

%util_num_periods;

%* Get all the variables by using proc contents *;
Proc Contents Data=&_dsnin Out=AllVars(keep=NAME) NoPrint;
Run;

proc sql noprint;
  select 'Y' into :_trt_time
        from allvars
        where upcase(name) like 'TR__STM';
quit;

%if %sysfunc(compress("&_analstarttmvar")) ne "" or 
    %sysfunc(compress("&_analstartdtmvar")) ne "" %then %do;
  proc sql noprint;
    select 'Y' into :_anal_time
        from allvars
        where upcase(name) in ("%upcase(&_analstarttmvar)", "%upcase(&_analstartdtmvar)");
  quit;
%end;

%if %sysfunc(compress("&_analendtmvar")) ne "" or 
    %sysfunc(compress("&_analenddtmvar")) ne "" %then %do;
  proc sql noprint;
    select 'Y' into :_anal_end_time
        from allvars
        where upcase(name) in ("%upcase(&_analendtmvar)", "%upcase(&_analenddtmvar)");
  quit;
%end;

***************************************************************************************;
* Specification 2                                                                     *;
* - Create three macro variables to hold analysis period start date (datetime variable*;
*   if time is captured), analysis period end date (datetime variable if time is      *;
*   captured), analysis date (datetime variable if time is captured)                  *;
* - Generate APERIOD, APERIODC, APHASE, TRTP, TRTA, TRTPN, TRTAN, APERDY, APERSDY,    *;
*   APEREDY, APERSDT, APEREDT APERSTM, APERETM, APERSDTM and APEREDTM variables       *;
*   as mentioned in the usage notes                                                   *;
* - Pass the drop variables in parameter _dropvars into util_chkvars macro and get    *;
*   the list of variables that are in the dataset that can be dropped                 *;
* - Assign attributes to the created variables                                        *;
***************************************************************************************;

%if &_trt_time = Y and &_anal_time = Y %then %do;

  %* Create new analysis start and end date/time variables that will hold the original values *;
  %* Adjust APxxSDT/STM/SDTM and APxxEDT/ETM/EDTM  based on the lag defined in the parameter *;
  %* g_adsl_pre_lag *;  
  data &_dsnin;
    set &_dsnin;
    %do _i = 1 %to %eval(&g_prdcnt);
        _AP%sysfunc(putn(&_i,Z2.))SDT  = AP%sysfunc(putn(&_i,Z2.))SDT;
        _AP%sysfunc(putn(&_i,Z2.))STM  = AP%sysfunc(putn(&_i,Z2.))STM;
        _AP%sysfunc(putn(&_i,Z2.))SDTM = AP%sysfunc(putn(&_i,Z2.))SDTM;
        _AP%sysfunc(putn(&_i,Z2.))EDT  = AP%sysfunc(putn(&_i,Z2.))EDT;
        _AP%sysfunc(putn(&_i,Z2.))ETM  = AP%sysfunc(putn(&_i,Z2.))ETM;
        _AP%sysfunc(putn(&_i,Z2.))EDTM = AP%sysfunc(putn(&_i,Z2.))EDTM;               
        %if &_i = 1 %then %do;
            AP%sysfunc(putn(&_i,Z2.))SDTM = AP%sysfunc(putn(&_i,Z2.))SDTM;
            AP%sysfunc(putn(&_i,Z2.))EDTM = AP%sysfunc(putn(&_i,Z2.))EDTM - hms(0,&g_adsl_pre_lag,0);            
        %end;
        %else %if &_i lt %eval(&g_prdcnt) %then %do;
            AP%sysfunc(putn(&_i,Z2.))SDTM = AP%sysfunc(putn(&_i,Z2.))SDTM - hms(0,&g_adsl_pre_lag,0);
            AP%sysfunc(putn(&_i,Z2.))EDTM = AP%sysfunc(putn(&_i,Z2.))EDTM - hms(0,&g_adsl_pre_lag,0);            
        %end;
        %else %if &_i = %eval(&g_prdcnt) %then %do;
            AP%sysfunc(putn(&_i,Z2.))SDTM = AP%sysfunc(putn(&_i,Z2.))SDTM - hms(0,&g_adsl_pre_lag,0);
            AP%sysfunc(putn(&_i,Z2.))EDTM = AP%sysfunc(putn(&_i,Z2.))EDTM;            
        %end;        
        AP%sysfunc(putn(&_i,Z2.))SDT = datepart(AP%sysfunc(putn(&_i,Z2.))SDTM);
        AP%sysfunc(putn(&_i,Z2.))STM = timepart(AP%sysfunc(putn(&_i,Z2.))SDTM);
        AP%sysfunc(putn(&_i,Z2.))EDT = datepart(AP%sysfunc(putn(&_i,Z2.))EDTM);
        AP%sysfunc(putn(&_i,Z2.))ETM = timepart(AP%sysfunc(putn(&_i,Z2.))EDTM);            
    %end; 
  run;  
    
  %let _sdt = APSDTM;
  %let _edt = APEDTM;  
  %if %sysfunc(compress("&_analstartdtmvar")) = "" %then %do;
    data &_dsnin;
      set &_dsnin;
      &_analstartdtvar.M = dhms(&_analstartdtvar,0,0,&_analstarttmvar); 
    run;
    %let _adt = &_analstartdtvar.M;
  %end;
  %else %do;
     %let _adt = &_analstartdtmvar;
  %end;
%end;
%else %do;
  %let _sdt = APSDT;
  %let _edt = APEDT;
  %let _adt = &_analstartdtvar;
%end;

%if &_trt_time = Y and &_anal_end_time = Y and %sysfunc(compress("&_analenddtvar")) ^= "" %then %do; 
  %if %sysfunc(compress("&_analenddtmvar")) = "" %then %do;
    data &_dsnin;
      set &_dsnin;
      &_analenddtvar.M = dhms(&_analenddtvar,0,0,&_analendtmvar); 
    run;
    %let _aendt = &_analenddtvar.M;
  %end;
  %else %do;
     %let _aendt = &_analenddtmvar;
  %end;
%end;
%else %if %sysfunc(compress("&_analenddtvar")) ^= "" %then %do;
     %let _aendt = &_analenddtvar;
%end;


%put Existing variables &_anal_varexist Drop &_dropvars;

%* Generate APERIOD APERIODC APHASE TRTP TRTA TRTPN TRTAN APERDY APERSDY *;
%* and APEREDY variables *;
data _dsnin;
  attrib APERIODC length=$20. label="Period (C)"
         APERIOD label="Period"
         APHASE length=$20. label="Phase"
         TRTP length=$100. label="Planned Treatment"
         TRTA length=$100. label="Actual Treatment" 
         TRTPN label="Planned Treatment (N)"
         TRTAN label="Actual Treatment (N)"
         %if &_sdt = APSDTM %then %do; 
           APERSTM label="Period Start Time" format=time8.
           APERETM label="Period End Time" format=time8.
           APERSDTM label="Period Start Date/Time" format=datetime20.
           APEREDTM label="Period End Date/Time" format=datetime20.
         %end; 
         APERSDT label="Period Start Date" format=date9. 
         APEREDT label="Period End Date" format=date9. 
         %if %eval(&g_prdcnt) > 1 %then %do; 
           %if %sysfunc(compress("&_analenddtvar")) ne "" %then %do;
             APERSDY label="Relative Start Day of Period Start"
             APEREDY label="Relative End Day of Period Start"
           %end;
           %else %do;
             APERDY label="Relative Day of Period Start"
           %end;
         %end; 
  ;       
  set &_dsnin;
  Array APSDT[*]
  %do _i = 1 %to %eval(&g_prdcnt);
    AP%sysfunc(putn(&_i,Z2.))SDT
  %end;
  ;
  Array APEDT[*]
  %do _i = 1 %to %eval(&g_prdcnt);
    AP%sysfunc(putn(&_i,Z2.))EDT
  %end;
  ;
  %* Create Time and Datetime arrays if time is collected or imputed;
  %if &_trt_time = Y and &_anal_time = Y %then %do;
    Array APSDTM[*]
    %do _i = 1 %to %eval(&g_prdcnt);
      AP%sysfunc(putn(&_i,Z2.))SDTM
    %end;
    ;
    Array APEDTM[*]
    %do _i = 1 %to %eval(&g_prdcnt);
      AP%sysfunc(putn(&_i,Z2.))EDTM
    %end;
    ;
  %end;

  %* TRTA TRTP TRTAN TRTPN APERIOD and APERIODC Derivation *;
  %do _j = 1 %to %eval(&g_prdcnt);
      %if &_j = 1 %then %do;
        %if %upcase(&_trtoption) = OPTION1 %then %do;
          if &_sdt[&_j] <= &_adt <= &_edt[&_j] and
                  ^missing(&_sdt[&_j]) and ^missing(&_adt) and
                  ^missing(&_edt[&_j]) then do;
        %end;
        %else %if %upcase(&_trtoption) = OPTION2 %then %do;
          if &_adt <= &_edt[&_j]  and ^missing(&_adt) and
             ^missing(&_edt[&_j])then do;
        %end;
            TRTP  = TRT%sysfunc(putn(&_j,Z2.))P;
            TRTA  = TRT%sysfunc(putn(&_j,Z2.))A;
            TRTPN = TRT%sysfunc(putn(&_j,Z2.))PN;
            TRTAN = TRT%sysfunc(putn(&_j,Z2.))AN;
            APERIOD  = &_j;
            APERIODC = "Period %sysfunc(putn(&_j,Z2.))";
        end;
      %end;
      %else %if &_j ne %eval(&g_prdcnt) %then %do;
        %if %upcase(&_trtoption) = OPTION1 %then %do;
          else if &_sdt[&_j] <= &_adt <= &_edt[&_j] and
                  ^missing(&_sdt[&_j]) and ^missing(&_adt) and
                  ^missing(&_edt[&_j]) then do;
        %end;
        %else %if %upcase(&_trtoption) = OPTION2 %then %do;
          else if &_edt[%eval(&_j-1)] < &_adt <= &_edt[&_j] and
                  ^missing(&_edt[%eval(&_j-1)]) and ^missing(&_adt) and
                  ^missing(&_edt[&_j]) then do;
        %end;
            TRTP  = TRT%sysfunc(putn(&_j,Z2.))P;
            TRTA  = TRT%sysfunc(putn(&_j,Z2.))A;
            TRTPN = TRT%sysfunc(putn(&_j,Z2.))PN;
            TRTAN = TRT%sysfunc(putn(&_j,Z2.))AN;
            APERIOD  = &_j;
            APERIODC = "Period %sysfunc(putn(&_j,Z2.))";
        end;
      %end;
      %else %if &_j = %eval(&g_prdcnt) %then %do;
        %if %upcase(&_trtoption) = OPTION1 %then %do;
          else if &_sdt[&_j] <= &_adt <= &_edt[&_j] and
                  ^missing(&_sdt[&_j]) and ^missing(&_adt) and
                  ^missing(&_edt[&_j]) then do;
        %end;
        %else %if %upcase(&_trtoption) = OPTION2 %then %do;
          else if &_adt > &_edt[%eval(&_j-1)] and ^missing(&_adt) and
                  ^missing(&_edt[%eval(&_j-1)]) then do;
        %end;
            TRTP  = TRT%sysfunc(putn(&_j,Z2.))P;
            TRTA  = TRT%sysfunc(putn(&_j,Z2.))A;
            TRTPN = TRT%sysfunc(putn(&_j,Z2.))PN;
            TRTAN = TRT%sysfunc(putn(&_j,Z2.))AN;
            APERIOD  = &_j;
            APERIODC = "Period %sysfunc(putn(&_j,Z2.))";
        end;
      %end;
  %end;

  %* Aphase derivation *;
  %do _l = 1 %to %eval(&g_prdcnt);
      %if &_l = 1 %then %do;
        if &_adt <= &_sdt[&_l] and ^missing(&_adt) and ^missing(&_sdt[&_l]) then do;
           Aphase = "PRE-TREATMENT";
        end;
        else if &_sdt[&_l] < &_adt <= &_edt[&_l] and ^missing(&_adt)
             and ^missing(&_sdt[&_l]) and ^missing(&_edt[&_l]) then do;
           Aphase = "TREATMENT "||"%sysfunc(putn(&_l,Z2.))";
        end;
        %if &g_prdcnt = 1 %then %do;
            else if &_adt > &_edt[&_l] and ^missing(&_adt)
                 and ^missing(&_edt[&_l]) then do;
              Aphase = "FOLLOW-UP";
            end;
        %end;
      %end;
      %else %if &_l lt %eval(&g_prdcnt) %then %do;
        else if &_edt[%eval(&_l-1)] < &_adt <= &_sdt[&_l] and 
                ^missing(&_edt[%eval(&_l-1)]) and ^missing(&_adt) and 
                ^missing(&_sdt[&_l]) then do;
             Aphase = "OFFDRUG "||"%sysfunc(putn(%eval(&_l-1),Z2.))";
        end;
        else if &_sdt[&_l] < &_adt <= &_edt[&_l] and ^missing(&_adt)
             and ^missing(&_sdt[&_l]) and ^missing(&_edt[&_l]) then do;
           Aphase = "TREATMENT "||"%sysfunc(putn(&_l,Z2.))";
        end;

      %end;
      %else %if &_l = %eval(&g_prdcnt) %then %do;
        else if &_edt[%eval(&_l-1)] < &_adt <= &_sdt[&_l] and 
                ^missing(&_edt[%eval(&_l-1)]) and ^missing(&_adt) and 
                ^missing(&_sdt[&_l]) then do;
             Aphase = "OFFDRUG "||"%sysfunc(putn(%eval(&_l-1),Z2.))";
        end;
        else if &_sdt[&_l] < &_adt <= &_edt[&_l] and ^missing(&_adt)
             and ^missing(&_sdt[&_l]) and ^missing(&_edt[&_l]) then do;
               Aphase = "TREATMENT "||"%sysfunc(putn(&_l,Z2.))";
        end;
        else if &_adt > &_edt[&_l] and 
             ^missing(&_adt) and ^missing(&_edt[&_l]) then do;
                Aphase = "FOLLOW-UP";
        end;
      %end;
  %end;

  %* APERDY APERSDY APEREDY Calculation *;
  %* Only for Crossover study *;
  %if %eval(&g_prdcnt) > 1 %then %do;
    %if %sysfunc(compress("&_analenddtvar")) ne "" %then %do;
      %do _m = 1 %to %eval(&g_prdcnt);
        %if &_m = 1 %then %do;
          if &_adt <= &_edt[&_m] and ^missing(&_adt) and 
             ^missing(&_edt[&_m]) then do;
               if &_analstartdtvar  < APSDT[&_m] then 
                  APERSDY =&_analstartdtvar  - APSDT[&_m];
               else if &_analstartdtvar  >= APSDT[&_m] then 
                  APERSDY = &_analstartdtvar - APSDT[&_m] + 1;
          end;
        %end;
        %else %if &_m ne %eval(&g_prdcnt) %then %do;
          else if &_edt[%eval(&_m - 1)] < &_adt <= &_edt[&_m] and 
               ^missing(&_adt) and ^missing(&_edt[&_m]) and 
               ^missing(&_edt[%eval(&_m - 1)]) then do;
                  if &_analstartdtvar  < APSDT[&_m] then 
                     APERSDY = &_analstartdtvar  - APSDT[&_m];
                  else if &_analstartdtvar >= APSDT[&_m] then 
                     APERSDY = &_analstartdtvar  - APSDT[&_m] + 1;
          end;
        %end;
        %else %if &_m = %eval(&g_prdcnt) %then %do;
          else if &_adt > &_edt[%eval(&_m - 1)] and 
               ^missing(&_adt) and ^missing(&_edt[%eval(&_m - 1)]) 
               then do;
                 if &_analstartdtvar  < APSDT[&_m] then 
                    APERSDY = &_analstartdtvar - APSDT[&_m];
                 else if &_analstartdtvar >= APSDT[&_m] then 
                    APERSDY = &_analstartdtvar - APSDT[&_m] + 1;
          end;
        %end;
      %end;
      %do _m = 1 %to %eval(&g_prdcnt);
        %if &_m = 1 %then %do;
          if &_aendt <= &_edt[&_m] and ^missing(&_aendt) and 
             ^missing(&_edt[&_m]) then do;
             if &_analenddtvar < APSDT[&_m] then 
                APEREDY =&_analenddtvar  - APSDT[&_m];
             else if &_analenddtvar >= APSDT[&_m] then 
                APEREDY = &_analenddtvar - APSDT[&_m] + 1;
          end;
        %end;
        %else %if &_m ne %eval(&g_prdcnt) %then %do;
          else if &_edt[%eval(&_m - 1)] < &_aendt <= &_edt[&_m] and 
                  ^missing(&_aendt) and ^missing(&_edt[&_m]) and 
                  ^missing(&_edt[%eval(&_m - 1)]) then do;
                    if &_analenddtvar < APSDT[&_m] then 
                       APEREDY = &_analenddtvar - APSDT[&_m];
                    else if &_analenddtvar >= APSDT[&_m] then 
                       APEREDY = &_analenddtvar - APSDT[&_m] + 1;
          end;
        %end;
        %else %if &_m = %eval(&g_prdcnt) %then %do;
          else if &_aendt > &_edt[%eval(&_m - 1)] and 
                  ^missing(&_aendt) and ^missing(&_edt[%eval(&_m - 1)]) then do;
                    if &_analenddtvar < APSDT[&_m] then 
                       APEREDY = &_analenddtvar - APSDT[&_m];
                    else if &_analenddtvar >= APSDT[&_m] then 
                       APEREDY = &_analenddtvar - APSDT[&_m] + 1;
          end;
        %end;
      %end;
    %end;
    %else %do;
      %do _m = 1 %to %eval(&g_prdcnt);
        %if &_m = 1 %then %do;
          if &_adt <= &_edt[&_m] and ^missing(&_adt) 
             and ^missing(&_edt[&_m]) then do;
               if &_analstartdtvar < APSDT[&_m] then 
                  APERDY = &_analstartdtvar - APSDT[&_m];
               else if &_analstartdtvar >= APSDT[&_m] then 
                  APERDY = &_analstartdtvar - APSDT[&_m] + 1;
          end;
        %end;
        %else %if &_m ne %eval(&g_prdcnt) %then %do;
          else if &_edt[%eval(&_m - 1)] < &_adt <= &_edt[&_m] and 
               ^missing(&_adt) and ^missing(&_edt[&_m]) and 
               ^missing(&_edt[%eval(&_m - 1)]) then do;
                 if &_analstartdtvar < APSDT[&_m] then 
                    APERDY = &_analstartdtvar - APSDT[&_m];
                 else if &_analstartdtvar >= APSDT[&_m] then 
                    APERDY = &_analstartdtvar - APSDT[&_m] + 1;
          end;
        %end;
        %else %if &_m = %eval(&g_prdcnt) %then %do;
          else if &_adt > &_edt[%eval(&_m - 1)] and 
               ^missing(&_adt) and ^missing(&_edt[%eval(&_m - 1)]) then do;
             if &_analstartdtvar < APSDT[&_m] and ^missing(APSDT[&_m]) then 
                APERDY = &_analstartdtvar - APSDT[&_m];
             else if &_analstartdtvar >= APSDT[&_m] and ^missing(APSDT[&_m]) then 
                APERDY = &_analstartdtvar - APSDT[&_m] + 1;
          end;
        %end;
      %end;
    %end;
  %end;

  %*APERSDT APEREDT APERSTM APERETM APERSDTM and APEREDTM Derivation *;

  %do _j = 1 %to %eval(&g_prdcnt);
    %if &_j = 1 %then %do;
      if &_adt <= &_edt[&_j]  and ^missing(&_adt) and
         ^missing(&_edt[&_j])then do;
        APERSDT  = AP%sysfunc(putn(&_j,Z2.))SDT;
        APEREDT  = AP%sysfunc(putn(&_j,Z2.))EDT;
        %if &_sdt = APSDTM %then %do;
          APERSTM  = AP%sysfunc(putn(&_j,Z2.))STM;
          APERETM  = AP%sysfunc(putn(&_j,Z2.))ETM;
          APERSDTM = AP%sysfunc(putn(&_j,Z2.))SDTM;
          APEREDTM = AP%sysfunc(putn(&_j,Z2.))EDTM;
        %end;
      end;
    %end;
    %else %if &_j ne %eval(&g_prdcnt) %then %do;
      else if &_edt[%eval(&_j-1)] < &_adt <= &_edt[&_j] and
              ^missing(&_edt[%eval(&_j-1)]) and ^missing(&_adt) and
              ^missing(&_edt[&_j]) then do;
        APERSDT  = AP%sysfunc(putn(&_j,Z2.))SDT;
        APEREDT  = AP%sysfunc(putn(&_j,Z2.))EDT;
        %if &_sdt = APSDTM %then %do;
          APERSTM  = AP%sysfunc(putn(&_j,Z2.))STM;
          APERETM  = AP%sysfunc(putn(&_j,Z2.))ETM;
          APERSDTM = AP%sysfunc(putn(&_j,Z2.))SDTM;
          APEREDTM = AP%sysfunc(putn(&_j,Z2.))EDTM;
        %end;
      end;
    %end;
    %else %if &_j = %eval(&g_prdcnt) %then %do;
      else if &_adt > &_edt[%eval(&_j-1)] and ^missing(&_adt) and
              ^missing(&_edt[%eval(&_j-1)]) then do;
        APERSDT  = AP%sysfunc(putn(&_j,Z2.))SDT;
        APEREDT  = AP%sysfunc(putn(&_j,Z2.))EDT;
        %if &_sdt = APSDTM %then %do;
          APERSTM  = AP%sysfunc(putn(&_j,Z2.))STM;
          APERETM  = AP%sysfunc(putn(&_j,Z2.))ETM;
          APERSDTM = AP%sysfunc(putn(&_j,Z2.))SDTM;
          APEREDTM = AP%sysfunc(putn(&_j,Z2.))EDTM;
        %end;
      end;
    %end;
  %end;

run;

%if %sysfunc(compress("&_dropvars")) ne "" %then %do;
  %util_chkvars(
                _dsnin   = _dsnin,
                _varlist = &_dropvars APERSDY APEREDY,
                _varexist= _anal_varexist,
                _missvar = _anal_missvars
               );
%end;

%* Drop the variables that are not needed and populate the APxxSDT/STM/SDTM and APxxEDT/ETM/EDTM *;
%* variables as in the ADSL dataset. *;
data &_dsnout;
     %if &_trt_time = Y and &_anal_time = Y %then %do;
       attrib
         %do _i = 1 %to %eval(&g_prdcnt);
           AP%sysfunc(putn(&_i,Z2.))SDT format=date9. label = "Period %sysfunc(putn(&_i,Z2.)) Start Date"
           AP%sysfunc(putn(&_i,Z2.))EDT format=date9. label = "Period %sysfunc(putn(&_i,Z2.)) End Date" 
           AP%sysfunc(putn(&_i,Z2.))STM format=time8. label = "Period %sysfunc(putn(&_i,Z2.)) Start Time"
           AP%sysfunc(putn(&_i,Z2.))ETM format=time8. label = "Period %sysfunc(putn(&_i,Z2.)) End Time"
           AP%sysfunc(putn(&_i,Z2.))SDTM format=datetime20. label = "Period %sysfunc(putn(&_i,Z2.)) Start Datetime"
           AP%sysfunc(putn(&_i,Z2.))EDTM format=datetime20. label = "Period %sysfunc(putn(&_i,Z2.)) End Date/Time"                
         %end;;
      %end;     
      set _dsnin(drop=
                   %if &_trt_time = Y and &_anal_time = Y %then %do; 
                       %if %sysfunc(compress("&_analstartdtmvar")) = "" %then %do;
                           &_analstartdtvar.M
                       %end; 
                       %do _i = 1 %to %eval(&g_prdcnt);
                           AP%sysfunc(putn(&_i,Z2.))SDT AP%sysfunc(putn(&_i,Z2.))STM AP%sysfunc(putn(&_i,Z2.))SDTM
                           AP%sysfunc(putn(&_i,Z2.))EDT AP%sysfunc(putn(&_i,Z2.))ETM AP%sysfunc(putn(&_i,Z2.))EDTM 
                       %end;
                   %end;
                   %if %sysfunc(compress("&_anal_varexist")) ne "" %then %do;
                       &_anal_varexist
                   %end;
                   %if &_trt_time = Y and &_anal_time = Y %then %do;
                     rename = (
                               %do _i = 1 %to %eval(&g_prdcnt);
                                   _AP%sysfunc(putn(&_i,Z2.))SDT = AP%sysfunc(putn(&_i,Z2.))SDT
                                   _AP%sysfunc(putn(&_i,Z2.))STM = AP%sysfunc(putn(&_i,Z2.))STM
                                   _AP%sysfunc(putn(&_i,Z2.))SDTM = AP%sysfunc(putn(&_i,Z2.))SDTM
                                   _AP%sysfunc(putn(&_i,Z2.))EDT = AP%sysfunc(putn(&_i,Z2.))EDT
                                   _AP%sysfunc(putn(&_i,Z2.))ETM = AP%sysfunc(putn(&_i,Z2.))ETM
                                   _AP%sysfunc(putn(&_i,Z2.))EDTM = AP%sysfunc(putn(&_i,Z2.))EDTM                      
                               %end;
                              )  
                   %end;
                );
run;

**************************************************************************************;
*  Specification 3: Delete all temporary local datasets                              *;
**************************************************************************************;

proc datasets library=work;
  delete Allvars ;
quit;

%mend gen_tp_join_adsl;
